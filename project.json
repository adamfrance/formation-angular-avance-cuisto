{
  "name": "cuisto",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "prefix": "app",
  "i18n": {
    "sourceLocale": "fr",
    "locales": {
      "en": {
        "translation": "src/locale/messages.en.xlf"
      }
    }
  },
  "generators": {},
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "browser": "src/main.ts",
        "tsConfig": "tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ],
        "styles": ["src/styles.css"],
        "outputPath": "dist/cuisto",
        "polyfills": ["@angular/localize/init"],
        "server": "src/main.server.ts",
        "ssr": {
          "entry": "src/server.ts"
        },
        "outputMode": "server",
        "security": {
          "allowedHosts": [
            "localhost"
          ]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all",
          "localize": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "cuisto:build:production"
        },
        "development": {
          "buildTarget": "cuisto:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "runner": "karma"
      }
    },
    "doc": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/doc"],
      "cache": true,
      "options": {
        "command": "compodoc -p tsconfig.doc.json -d dist/doc"
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "cuisto:build"
      }
    }
  }
}
